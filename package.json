{
  "name": "sunny-acres",
  "version": "0.2.0",
  "private": true,
  "description": "Harvest Moon style farming game: Phaser 3, portrait, touch-first, single offline HTML file.",
  "scripts": {
    "art": "node tools/make-art.js",
    "map": "node tools/make-map.js",
    "build": "node build.js",
    "test": "node --test test/logic.test.js test/rules.test.js test/content.test.js",
    "test:e2e": "node build.js && node --test test/e2e.test.js"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
